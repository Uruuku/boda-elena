# >>> CAMBIAR AQUI <<<  (todo este archivo)
#
# 1) Copia este archivo y a la copia llámala exactamente:   .env.local
# 2) Rellena los valores en la copia (.env.local). Este .env.example déjalo como está.
# (.env.local NO se sube a GitHub; en Vercel se ponen en Settings > Environment Variables)

# ---------- OBLIGATORIO ----------

# Token del almacén de fotos. Se consigue en Vercel > Storage > Blob > pestaña ".env.local"
BLOB_READ_WRITE_TOKEN=""

# Contraseña del modo administrador (borrar fotos y descargar todo el muro).
# Se activa tocando 5 veces seguidas el título "Muro de Recuerdos".
ADMIN_PASSWORD=""

# ---------- CORREO DE RESPALDO (opcional pero recomendado) ----------
# Cada vez que un invitado sube fotos, llega un email con ellas adjuntas.
# Si el muro se llena, las fotos siguen llegando por aquí. Si dejas estas
# variables vacías, la web funciona igual pero sin correo.

# Cuenta de Gmail desde la que se ENVÍAN los correos
SMTP_USER=""
# Contraseña de aplicación de esa cuenta (16 letras, NO la contraseña normal; ver README)
SMTP_PASSWORD=phhf itln skug skub
# Correo donde quieres RECIBIR las fotos (puede ser el mismo de arriba)
DESTINATION_EMAIL=""

# Estos tres no hace falta tocarlos si usas Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
